    "title": "Saturated mutagenesis screen of M-MLV reverse transcriptase identifies variants enhancing prime editing efficiency",
    "authors": "Li, H.; Wang, Y.; Zhang, C.; Tun, T. T.; Yu, S.; Hu, C.; Yu, H.",
    "author_corresponding": "Haojie Yu",
    "author_corresponding_institution": "National University of Singapore",
